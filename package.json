{
    "name": "@arnonym/result",
    "version": "1.0.5",
    "description": "Result type for TypeScript inspired by Rust",
    "keywords": [
        "result",
        "typescript",
        "rust",
        "error handling"
    ],
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "repository": {
        "url": "https://github.com/arnonym/result"
    },
    "scripts": {
        "build": "rm -rf dist; vite build --mode esm && vite build --mode cjs",
        "publish-npm": "npm publish --access public",
        "compile": "tsc --noEmit",
        "test": "jest",
        "lint": "eslint",
        "check": "npm run compile && npm run test && npm run lint",
        "format": "prettier '**/*.{ts,md,mjs,json,yml}'",
        "format:write": "npm run format -- --write",
        "format:check": "npm run format -- --check"
    },
    "author": "Arne Gellhaus",
    "license": "Apache-2.0",
    "devDependencies": {
        "@eslint/js": "^9.33.0",
        "@jest/globals": "^30.0.5",
        "@types/jest": "^30.0.0",
        "eslint": "^9.33.0",
        "jest": "^30.0.5",
        "prettier": "^3.6.2",
        "ts-jest": "^29.4.1",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.2",
        "typescript-eslint": "^8.39.0",
        "vite": "^6.1.0",
        "vite-plugin-dts": "^4.5.4"
    },
    "prettier": {
        "tabWidth": 4,
        "singleQuote": true,
        "trailingComma": "all",
        "arrowParens": "avoid"
    },
    "files": [
        "/dist"
    ]
}
